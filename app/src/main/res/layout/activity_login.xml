<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_full"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:minHeight="640dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="20dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="36dp"
                android:gravity="center">

                <!-- Logo Wrapper -->
                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginBottom="24dp">

                    <!-- Halo effect -->
                    <View
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:background="@drawable/bg_logo_halo" />

                    <!-- Logo -->
                    <ImageView
                        android:id="@+id/logoImage"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:src="@drawable/logo"
                        android:scaleType="fitCenter"
                        android:contentDescription="لوگو" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="پانسیون فراسو"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#0C4A6E"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="برای ورود، کد ملی خود را وارد کنید"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="farasoo.space"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#29A8DF"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="32dp" />

                <!-- Error -->
                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FEE2E2"
                    android:textColor="#991B1B"
                    android:padding="12dp"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginBottom="15dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="کد ملی"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0369A1"
                    android:layout_marginBottom="8dp" />

                <!-- Input Wrapper with glow -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">

                    <EditText
                        android:id="@+id/nationalIdInput"
                        android:layout_width="match_parent"
                        android:layout_height="66dp"
                        android:background="@drawable/bg_input_premium"
                        android:hint="0012345678"
                        android:textColorHint="#94A3B8"
                        android:textColor="#0C4A6E"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="10"
                        android:letterSpacing="0.2"
                        android:paddingHorizontal="20dp" />

                </FrameLayout>

                <Button
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:text="ورود به پنل"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_premium"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:elevation="8dp" />

                <ProgressBar
                    android:id="@+id/loginProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
